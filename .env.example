APP_NAME="marina.newyorkcity"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# eshlink CMS. Leaving CMS_ADMIN_DOMAIN unset is the safe state: the admin,
# MCP and service routes are not registered at all without it, so every admin
# path 404s on the public site because there is no route to match.
CMS_SITE_SLUG=marina
CMS_SITE_NAME="${APP_NAME}"
CMS_ADMIN_DOMAIN=
CMS_PREVIEW_DOMAIN=
# Mode for a host that config/cms.php does not name. Preview, so an unknown
# Host header gets the undiscoverable posture rather than the indexable one.
CMS_DEFAULT_MODE=preview
# Laravel Cloud's filesystem is ephemeral, so production media belongs on
# object storage. Local development keeps it on disk.
CMS_MEDIA_DISK=local
CMS_MEDIA_QUARANTINE_DISK=local
CMS_READ_CACHE_TTL=60

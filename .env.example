APP_NAME="marina.newyorkcity"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# eshlink CMS. Leaving CMS_ADMIN_DOMAIN unset is the safe state: the admin,
# MCP and service routes are not registered at all without it, so every admin
# path 404s on the public site because there is no route to match.
CMS_SITE_SLUG=marina
CMS_SITE_NAME="${APP_NAME}"
CMS_ADMIN_DOMAIN=
CMS_PREVIEW_DOMAIN=
# Shared secret the hub sends to /_cms/health. Unset means the service API
# 404s entirely, which is correct until this site is onboarded — a liveness
# endpoint that answers a stranger tells them this host runs the CMS.
CMS_SERVICE_TOKEN=
# Mode for a host that config/cms.php does not name. Preview, so an unknown
# Host header gets the undiscoverable posture rather than the indexable one.
CMS_DEFAULT_MODE=preview
# Laravel Cloud's filesystem is ephemeral, so production media belongs on
# object storage. Local development keeps it on disk.
CMS_MEDIA_DISK=local
CMS_MEDIA_QUARANTINE_DISK=local
CMS_READ_CACHE_TTL=60
# The MCP endpoint and its two credential lanes. Both off here, because a
# checkout that has not set CMS_ADMIN_DOMAIN has nowhere to put them anyway.
#
#  - CMS_MCP_ENABLED alone gives the Sanctum lane: a token from `cms:token`
#    pasted into Claude Code's --header flag.
#  - CMS_MCP_OAUTH_ENABLED adds the OAuth lane, which is the only one a
#    claude.ai or ChatGPT connector can use — a connector platform has nowhere
#    to put a header. Note the trade: Claude Code stops using a static bearer
#    the moment a server advertises OAuth.
#  - CMS_MCP_GUARD is a comma-separated LIST and leaving it unset is correct;
#    the package then tries `sanctum,cms-oauth` in that order. Writing just
#    `sanctum` into it turns the connector lane off while every switch above
#    still reads as on, which is a miserable thing to diagnose.
#  - CMS_MCP_OAUTH_ISSUER stays unset so the issuer is derived from
#    CMS_ADMIN_DOMAIN. It has to be ONE string across both discovery documents
#    and the `iss` on every authorization response; two spellings are two
#    authorization servers to a conforming client. Set it only for a second
#    admin alias, then never change it.
# CMS_MCP_ENABLED=false
# CMS_MCP_OAUTH_ENABLED=false
# Passport's signing keys. `php artisan passport:keys` writes them under
# storage/, which is fine locally and useless on Laravel Cloud, where the
# filesystem is ephemeral: a site that regenerates its keypair every deploy
# invalidates every token it ever issued, and the symptom is a connector that
# works until the next deploy. Generate the pair once and carry it in the
# environment instead, newlines and all.
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
